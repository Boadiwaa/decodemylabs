# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# MedGemma model weights — these are 2-3 GB each and MUST NOT be committed.
# Download them separately using scripts/download-models.sh
# See SETUP.md for instructions.
models/*.gguf
models/*.bin
models/*.litertlm

# Native module build output
modules/*/android/build/
modules/*/android/.gradle/

# Local debugging artifacts and editor settings
.tmp_*
.Rhistory
.idea/
.vscode/
