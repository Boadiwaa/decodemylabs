{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_MODEL_PROVIDER": "local",
        "EXPO_PUBLIC_LOCAL_INFERENCE_RUNTIME": "litertlm",
        "EXPO_PUBLIC_ALLOW_EMULATOR_MODEL_LOAD": "false",
        "EXPO_PUBLIC_ALLOW_ANDROID_LLAMA_FALLBACK": "false"
      }
    },
    "production": {
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_MODEL_PROVIDER": "local",
        "EXPO_PUBLIC_LOCAL_INFERENCE_RUNTIME": "litertlm",
        "EXPO_PUBLIC_ALLOW_EMULATOR_MODEL_LOAD": "false",
        "EXPO_PUBLIC_ALLOW_ANDROID_LLAMA_FALLBACK": "false"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
